{
  "name": "panel-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/version.mjs && vite",
    "build": "node scripts/version.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/version.mjs && tsc -b --noEmit",
    "build:single": "node scripts/version.mjs && tsc -b && vite build --mode single && node scripts/finish-single.mjs",
    "icons": "node scripts/make-icons.mjs",
    "ver": "node scripts/version.mjs"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "encoding-japanese": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
