  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
